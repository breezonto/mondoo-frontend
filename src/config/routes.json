[
  {
    "path": "/user",
    "component": "MainLayout",
    "meta": {
      "requiresAuth": true
    },
    "children": [
      {
        "path": "welcome",
        "name": "user-welcome",
        "component": "Espacio",
        "meta": {
          "title": "Main Page"
        }
      },
      {
        "path": "session/:historyId",
        "name": "user-session",
        "component": "Espacio",
        "meta": {
          "title": "Session"
        }
      },
      {
          "path": "library",
          "name": "user-library",
          "component": "FileLibrary",
          "meta": {
            "title": "Library"
          }
      },
      {
        "path": "menu",
        "name": "menu",
        "component": "MenuListView",
        "meta": {
          "title": "Menu"
        }
      },
      {
        "path": "history/manage",
        "name": "message-history",
        "component": "HistoryListView",
        "meta": {
          "title": "Message History"
        }
      }
    ]
  },

  {
    "path": "",
    "redirect": "/user/welcom"
  }
]